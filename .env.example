# Interpretex — shared environment template (copy to .env and fill in)
# All three parts read the same values; keep them identical across machines.

# --- LLM provider -----------------------------------------------------------
# OpenRouter API key (required for live LLM calls; ScriptedLLM works without it)
OPENROUTER_API_KEY=
# Exact OpenRouter model slug — verify on https://openrouter.ai/models before
# the build starts; every machine must use the identical string.
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
# openrouter | scripted   (scripted = offline canned responses, used in CI)
LLM_PROVIDER=scripted
# readwrite | read | write | off   (stage/demo uses `read`: zero network, byte-identical replay)
LLM_CACHE_MODE=readwrite
LLM_CACHE_DIR=./.llm_cache
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# --- Feature flags (1=on, 0=off) ---------------------------------------------
FEATURE_NETWORK=1
FEATURE_ATTACKER=1
FEATURE_HISTORICAL=1

# --- Misc ---------------------------------------------------------------------
AGENT_SEED=
INTERPRETEX_DATA_DIR=
