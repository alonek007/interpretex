# Interpretex shared environment (copy to .env and fill in)
# All three machines must use the identical LLM_MODEL string.

OPENROUTER_API_KEY=
# OpenRouter model slug — verify on https://openrouter.ai/models in hour 0
LLM_MODEL=openrouter/auto

# LLM cassette cache: off | read | write
LLM_CACHE_MODE=off
LLM_CACHE_DIR=.llm_cache

# Feature flags
FEATURE_BUDGET=1
FEATURE_NETWORK=1
FEATURE_ATTACKER=1

# Agent safety caps
AGENT_MAX_STEPS=10
